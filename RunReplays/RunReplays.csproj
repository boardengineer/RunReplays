<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Behavior flags — all configurations. -->
        <!-- RUNREPLAYS_AUTOPLAY (auto-launch a hard-coded replay from the main menu) is disabled on this branch. -->
        <!-- <DefineConstants>$(DefineConstants);RUNREPLAYS_AUTOPLAY</DefineConstants> -->
        <!-- Mod-generated dev-console logging — compiled out of Release builds.
             RUNREPLAYS_DEVCONSOLE gates the console sink itself; the category
             flags gate the individual logging helpers. -->
        <DefineConstants Condition="'$(Configuration)' != 'Release'">$(DefineConstants);RUNREPLAYS_MIGRATION;RUNREPLAYS_VERBOSE;RUNREPLAYS_DISPATCHER;RUNREPLAYS_DEVCONSOLE</DefineConstants>
    </PropertyGroup>

    <!-- Game assemblies to compile against (STS2 release branches differ in code): the live install by default, or a
         snapshot of a specific Steam branch, e.g. -p:STS2GameData=C:\sts-sim\gamebuilds\public-beta-24724944\data_sts2_windows_x86_64
         (see C:\sts-sim\GAME_BRANCHES.md). -->
    <PropertyGroup>
        <STS2GameData Condition="'$(STS2GameData)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\data_sts2_windows_x86_64</STS2GameData>
    </PropertyGroup>

    <!-- BaseLib: the installed mod, else the NuGet cache copy (alchyr.sts2.baselib), else pass -p:BaseLibDll=<path> -->
    <PropertyGroup>
        <BaseLibDll Condition="'$(BaseLibDll)' == ''">..\..\..\..\..\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\mods\BaseLib.dll</BaseLibDll>
        <BaseLibDll Condition="!Exists('$(BaseLibDll)') And Exists('$(NuGetPackageRoot)alchyr.sts2.baselib\3.1.0\lib\net9.0\BaseLib.dll')">$(NuGetPackageRoot)alchyr.sts2.baselib\3.1.0\lib\net9.0\BaseLib.dll</BaseLibDll>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="sts2">
        <HintPath>$(STS2GameData)\sts2.dll</HintPath>
      </Reference>
      <Reference Include="BaseLib">
        <HintPath>$(BaseLibDll)</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="GodotSharp" Version="4.7.0-dev.2" />
      <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    </ItemGroup>

    <ItemGroup>
