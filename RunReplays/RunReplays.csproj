    <!-- dotnet build -p:SkipModCopy=true builds without copying the DLL into the game's mods folder -->
    <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(SkipModCopy)' != 'true'">
      <Exec Command=":: For Windows&#xA;xcopy &quot;$(TargetPath)&quot; &quot;C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\mods\&quot; /Y&#xA;xcopy &quot;$(ProjectDir)RunReplays.json&quot; &quot;C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2\mods\&quot; /Y" />
